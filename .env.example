NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
DATABASE_URL="postgresql://postgres:password@localhost:5432/QueueFlow?schema=public"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_CACHE_DEFAULT_TTL_SECONDS=300
REALTIME_REDIS_ADAPTER_ENABLED=true
BULLMQ_PREFIX=queueflow
NOTIFICATION_JOB_ATTEMPTS=5
NOTIFICATION_JOB_BACKOFF_MS=1000
CORS_ORIGIN=http://localhost:3001
BCRYPT_ROUNDS=12
LOG_LEVEL=debug
SWAGGER_ENABLED=true
